{
  "name": "hemitube",
  "version": "1.1.0",
  "private": true,
  "description": "A Chromium extension for YouTube: full-window theater mode, dislike counts, automatic quality, codec selection, SponsorBlock and hidden Shorts.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "test": "node --test \"tests/*.test.mjs\"",
    "lint": "eslint .",
    "package": "node scripts/package.mjs",
    "crx": "node scripts/crx.mjs",
    "icons": "node scripts/make-icons.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "verify": "node scripts/verify-dist.mjs",
    "e2e": "node tests/e2e/brave.e2e.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "crx3": "2.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "globals": "17.14.0"
  }
}
